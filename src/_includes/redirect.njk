<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="{{ site.url }}{{ redirect }}" />
    <meta http-equiv="refresh" content="0; url={{ redirect }}" />
  </head>
  <body>
    <p>This page moved to <a href="{{ redirect }}">{{ site.url }}{{ redirect }}</a>.</p>
  </body>
</html>
